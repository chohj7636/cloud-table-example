{
    "singleQuote": true,
    "semi": true,
    "useTabs": false,
    "tabWidth": 2,
    "trailingComma": "all",
    "printWidth": 800,
    "importOrder": [
      "^react",
      "^next",
      "<THIRD_PARTY_MODULES>",
  
      "^~/api/(.*)$",
      "^~/hooks/(.*)$",
      "^~/components/(.*)$",
      "^~/utils/(.*)$",
  
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ]
  }